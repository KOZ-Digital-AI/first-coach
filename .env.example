# Copy to .env and adjust. Placeholders only: never commit real secrets.
# Uncommented lines are active defaults or required values; commented lines are optional.

# HTTP port the API listens on (optional, default 4111).
PORT=4111
# Path to the SQLite application database (optional, default ./data/app.db).
APP_DB_PATH=./data/app.db
# Directory for uploaded media files (optional).
# MEDIA_DIR=./data/media
# Path to the Mastra storage database (optional).
# MASTRA_DB_PATH=./data/mastra.db
# Directory where database backups are written (optional).
# BACKUP_DIR=./data/backups
# Directory of the built web app served by the API (optional, default apps/web/dist).
WEB_DIST=apps/web/dist
# Build identifier reported by the API, e.g. a git SHA (optional).
# BUILD_VERSION=
# Secret used to sign auth sessions; at least 32 characters (required in production).
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Public base URL of the app, used by auth (required in production).
BETTER_AUTH_URL=http://localhost:4111
# OpenAI API key; leave empty to disable AI features (optional).
# OPENAI_API_KEY=
# OpenAI model used for text generation (optional).
# OPENAI_MODEL=
# OpenAI model used for image understanding (optional).
# OPENAI_VISION_MODEL=
# Contact email shown in the web app, read at build time (optional).
# VITE_CONTACT_EMAIL=
